<!DOCTYPE html>

<html class="light" lang="en">
    <head>
        <meta charset="utf-8"/>
        <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
        <title>What'sInMyFridge</title>
        <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
        <link href="https://fonts.googleapis.com/css2?family=Epilogue:wght@400;500;600;700;800;900&amp;display=swap" rel="stylesheet"/>
        <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet"/>
        <script>
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        colors: {
                            "primary": "#4cdf20",
                            "background-light": "#f6f8f6",
                            "background-dark": "#152111",
                        },
                        fontFamily: {
                            "display": ["Epilogue", "sans-serif"]
                        },
                        borderRadius: {
                            "DEFAULT": "0.25rem",
                            "lg": "0.5rem",
                            "xl": "0.75rem",
                            "full": "9999px"
                        },
                    },
                },
            }
        </script>
        <style>
            .material-symbols-outlined {
                font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
                font-size: 24px;
            }
        </style>
    </head>
    <body class="bg-background-light dark:bg-background-dark font-display">
        <div class="relative flex min-h-screen w-full flex-col group/design-root overflow-x-hidden">
            <div class="layout-container flex h-full grow flex-col">
                <div class="flex flex-1 justify-center py-5 sm:px-4 md:px-10 lg:px-20 xl:px-40">
                    <div class="layout-content-container flex flex-col w-full max-w-[960px] flex-1">
                        <!-- TopNavBar -->
                        <header class="flex items-center justify-between whitespace-nowrap border-b border-solid border-black/10 dark:border-white/10 px-4 md:px-10 py-3">
                            <div class="flex items-center gap-8">
                                <div class="flex items-center gap-4 text-black dark:text-white">
                                    <div class="size-8 text-primary">
                                        <img alt="logo" src="./logo.jpg" />
                                    </div>
                                    <h2 class="text-black dark:text-white text-lg font-bold leading-tight tracking-[-0.015em]">What'sInMyFridge</h2>
                                </div>
                            </div>
                        <div class="flex flex-1 justify-end gap-2 md:gap-8">
                            <div class="hidden md:flex items-center gap-9">
                                <a class="hover:text-primary text-sm font-medium leading-normal" href="/home.html">Home</a>
                                <a class="hover:text-primary text-sm font-medium leading-normal" href="/search.html">Search</a>
                                <a class="hover:text-primary text-sm font-medium leading-normal" href="/map.html">Map</a>
                                <a class="hover:text-primary text-sm font-medium leading-normal" href="/recommendations.html">Favourite</a>
                            </div>
                            </div>
                        </header>
                        <!-- Page Heading -->
                        <div class="flex flex-wrap justify-between gap-3 p-4">
                        <div class="flex min-w-72 flex-col gap-2">
                            <p class="text-black dark:text-white text-4xl font-black leading-tight tracking-[-0.03em]">
                            Dishes you can make with
                            </p>
                            <p class="text-primary text-lg font-semibold">
                            <%= query %>
                            </p>
                        </div>
                        </div>

                        <!-- Recipe Grid -->
                        <div class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-6 p-4">

                        <% if (recipes && recipes.length > 0) { %>
                        <% recipes.forEach(recipe => { %>

                        <div class="bg-white dark:bg-[#1e2a1b] rounded-xl shadow-md hover:shadow-xl transition-all duration-300 border border-black/10 dark:border-white/10 overflow-hidden group">

                            <!-- Image -->
                            <a href="/api/search/recipe/<%= encodeURIComponent(recipe.TranslatedRecipeName) %>">
                            <div class="relative h-64 overflow-hidden">
                                <img 
                                src="<%= recipe.ImageURL %>" 
                                alt="<%= recipe.TranslatedRecipeName %>"
                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                />

                                <!-- Missing Badge -->
                                <div class="absolute top-3 left-3 bg-primary text-black text-xs font-bold px-3 py-1 rounded-full shadow">
                                Missing: <%= recipe.ExtraIngredientsCount %>
                                </div>
                                <button
                                    type="button"
                                    class="favorite-btn absolute top-3 right-3 w-10 h-10 rounded-full bg-white/90 backdrop-blur shadow flex items-center justify-center text-slate-500 hover:text-red-500 transition-colors"
                                    data-name="<%= recipe.TranslatedRecipeName %>"
                                    data-image="<%= recipe.ImageURL %>"
                                    data-cuisine="<%= recipe.Cuisine %>"
                                    data-diet="<%= recipe.Diet %>"
                                    data-missing="<%= recipe.ExtraIngredientsCount %>"
                                >
                                    <span class="material-symbols-outlined">favorite</span>
                                </button>
                            </div>
                            </a>

                            <!-- Content -->
                            <div class="p-4 flex flex-col gap-2">

                            <!-- Title -->
                            <p class="text-black dark:text-white text-lg font-bold leading-tight group-hover:text-primary transition-colors">
                                <%= recipe.TranslatedRecipeName %>
                            </p>

                            <!-- Meta Info -->
                            <p class="text-slate-600 dark:text-slate-400 text-sm">
                                <span class="font-medium">Cuisine:</span> <%= recipe.Cuisine || "N/A" %>
                            </p>

                            <p class="text-slate-600 dark:text-slate-400 text-sm">
                                <span class="font-medium">Diet:</span> <%= recipe.Diet || "N/A" %>
                            </p>

                            <!-- CTA Button -->
                            <a href="/api/search/recipe/<%= encodeURIComponent(recipe.TranslatedRecipeName) %>"
                                class="mt-3 inline-flex items-center justify-center gap-2 bg-primary text-black font-semibold py-2 rounded-lg hover:opacity-90 transition">

                                View Recipe
                                <span class="material-symbols-outlined text-base">arrow_forward</span>
                            </a>

                            </div>
                        </div>

                        <% }) %>

                        <% } else { %>

                        <div class="col-span-full text-center py-16">
                            <p class="text-gray-500 text-lg">
                            No recipes found for "<span class="font-semibold text-primary"><%= query %></span>"
                            </p>
                        </div>

                        <% } %>

                        </div>

                    </div>
                </div>
            </div>
        </div>
            <script>
            const favoriteButtons = document.querySelectorAll(".favorite-btn");
            favoriteButtons.forEach(button => {
                button.addEventListener("click", async (event) => {
                    event.preventDefault();
                    event.stopPropagation();
                    const email = localStorage.getItem("currentUserEmail");
                    if (!email) {
                        alert("Please sign in to save favourite recipes.");
                        return;
                    }

                    const recipe = {
                        TranslatedRecipeName: button.dataset.name,
                        ImageURL: button.dataset.image,
                        Cuisine: button.dataset.cuisine,
                        Diet: button.dataset.diet,
                        ExtraIngredientsCount: button.dataset.missing,
                    };

                    const response = await fetch("/api/search/favorite", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ email, recipe }),
                    });

                    if (response.ok) {
                        button.classList.remove("text-slate-500");
                        button.classList.add("text-red-500");
                        alert("Recipe saved to favourites.");
                    } else {
                        alert("Could not save recipe. Please try again.");
                    }
                });
            });
        </script>
    </body>
</html>